; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="idle game"
run/main_scene="uid://bj8tenpaqqsut"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

PlayerProgress="*uid://316bob1xainb"
PlayerInventory="*uid://bubpl5hv8kp80"
SceneManager="*uid://byyql836gwgto"
IdleProgress="*uid://dov7m1cqcemh7"
EquipmentManager="*uid://dgcauqgjrih33"
BattleVariables="*uid://bdd3tdbyvsbk0"
StepsProgress="*uid://cfgfym31wxges"
PlayerAppearance="*uid://b34vpsjibdxjr"
ScreenTimeProgress="*uid://dldxvwrpkyk2h"
SkillManager="*uid://wih1s47upqla"
SaveManager="*uid://cn1tcr3s3kc5t"
ShopCatalogue="*uid://w7ai75trtqdi"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="idle game"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotScreenTimePlugin/plugin.cfg", "res://addons/GodotStepPlugin/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
